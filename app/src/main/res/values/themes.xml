<resources>
    <style name="Theme.freezeit" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="actionBarStyle">@style/Frozen.ActionBar</item>
        <item name="actionBarTheme">@style/Frozen.ActionBarTheme</item>
        <item name="bottomNavigationStyle">@style/Frozen.BottomNavigation</item>
        <item name="floatingActionButtonStyle">@style/Frozen.FloatingActionButton</item>
        <item name="materialAlertDialogTheme">@style/Frozen.DialogTheme</item>
        <item name="alertDialogTheme">@style/Frozen.DialogTheme</item>
    </style>

    <style name="Frozen.ActionBarTheme" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorControlNormal">@color/md_on_surface</item>
        <item name="actionMenuTextColor">@color/md_on_surface</item>
        <item name="titleTextColor">@color/md_on_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
    </style>

    <style name="Frozen.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="android:background">@color/md_surface</item>
        <item name="background">@color/md_surface</item>
        <item name="titleTextStyle">@style/Frozen.ActionBar.Title</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Frozen.ActionBar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Frozen.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_floating_nav_bar</item>
        <item name="itemActiveIndicatorStyle">@style/Frozen.NavigationIndicator</item>
        <item name="itemIconTint">@color/navigation_item_tint</item>
        <item name="itemTextColor">@color/navigation_item_tint</item>
        <item name="itemIconSize">24dp</item>
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="elevation">10dp</item>
        <item name="itemRippleColor">@color/md_primary_container</item>
    </style>

    <style name="Frozen.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator_color</item>
        <item name="android:width">60dp</item>
        <item name="android:height">36dp</item>
    </style>

    <style name="Frozen.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/md_primary</item>
        <item name="tint">@color/md_on_primary</item>
        <item name="elevation">4dp</item>
    </style>

    <style name="Frozen.DialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@drawable/bg_liquid_glass_dialog</item>
        <item name="shapeAppearance">@style/Frozen.DialogShape</item>
    </style>

    <style name="Frozen.DialogShape" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/dialog_corner_radius</item>
    </style>

    <style name="footButton" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/md_primary</item>
    </style>
</resources>
