<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/liquid_glass_card_bg" />
            <corners android:radius="@dimen/dialog_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B3FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#0DF0FDF4"
                android:type="linear" />
            <corners android:radius="@dimen/dialog_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.8dp"
                android:color="@color/liquid_glass_stroke" />
            <corners android:radius="@dimen/dialog_corner_radius" />
        </shape>
    </item>
</layer-list>
