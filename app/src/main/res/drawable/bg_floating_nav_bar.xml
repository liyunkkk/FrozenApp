<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lumi_Books Style Liquid Glass: 1. 水润冰晶折射半透明基底 (有厚度与通透介质感) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#6EFFFFFF"
                android:endColor="#48EBF5FF"
                android:type="linear" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Lumi_Books Style Liquid Glass: 2. 穹顶表面张力折射微弧面 (上沿高折射，中部通透) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#02FFFFFF"
                android:type="linear" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Lumi_Books Style Liquid Glass: 3. 全反射纯白高光外棱角描边 (清晰的玻璃折射边缘) -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.25dp"
                android:color="#E0FFFFFF" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
